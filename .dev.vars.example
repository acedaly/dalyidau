# Copy to .dev.vars for local development. Never commit .dev.vars.
# Point local dev at the mock Capacities server (npm run mock:capacities)...
CAPACITIES_API_BASE=http://localhost:8790
CAPACITIES_API_TOKEN=cap-api-local-mock
ADMIN_TOKEN=local-admin-token-change-me-0123456789
SYNC_REQUEST_SPACING_MS=0
ENVIRONMENT=development
SITE_URL=http://localhost:8787

# Portal (docs/PORTAL.md). Local only: act as this owner without Cloudflare Access.
# Works only with ENVIRONMENT=development and a localhost SITE_URL.
ACCESS_DEV_EMAIL=you@example.com
PORTAL_OWNER_EMAILS=you@example.com
# Local-only HMAC key for native RSVP invitation links. Use a different Wrangler secret per deployed environment.
RSVP_LINK_SECRET=local-rsvp-link-secret-change-me-32-bytes-minimum

# Communications (docs/COMMUNICATIONS.md). "log" prints instead of sending and only works locally.
# Real providers ("smtp2go", "clicksend") also need their secrets and the switches in Wedding settings → Features.
EMAIL_DELIVERY=off
SMS_DELIVERY=off
