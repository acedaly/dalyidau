{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalyidau",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "tsconfig": "tsconfig.worker.json",
  "keep_vars": false,
  "minify": true,
  "define": {
    "process.env.NODE_ENV": "\"production\""
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dalyidau-production",
      "database_id": "a003fec1-8404-4468-a23f-de5fb202bc57",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dalyidau-media"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://daly.id.au",
    "WEDDING_URL": "https://wedding.daly.id.au",
    "CAPACITIES_API_BASE": "https://api.capacities.io",
    "CAPACITIES_STRUCTURE_NAME": "Blog Post",
    "SYNC_MAX_REQUESTS": "40",
    "SYNC_REQUEST_SPACING_MS": "2100",
    "IMAGE_TRANSFORMS": "off",
    "EMAIL_DELIVERY": "fastmail",
    "EMAIL_FROM": "\"Amelia & Aidan\" <wedding@daly.id.au>",
    "EMAIL_REPLY_TO": "wedding@daly.id.au",
    "SMS_DELIVERY": "clicksend",
    "AI_GATEWAY_ID": "daly-intelligence"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "daly.id.au",
      "custom_domain": true
    },
    {
      "pattern": "www.daly.id.au",
      "custom_domain": true
    },
    {
      "pattern": "wedding.daly.id.au",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "staging": {
      "name": "dalyidau-staging",
      "workers_dev": true,
      "routes": [],
      "define": {
        "process.env.NODE_ENV": "\"production\""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dalyidau-staging",
          "database_id": "a88696eb-3621-4dcb-ac9f-a907a9cd9c06",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "dalyidau-media-staging"
        }
      ],
      "triggers": {
        "crons": []
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://daly.id.au",
        "WEDDING_URL": "https://wedding.daly.id.au",
        "CAPACITIES_API_BASE": "https://api.capacities.io",
        "CAPACITIES_STRUCTURE_NAME": "Blog Post",
        "SYNC_MAX_REQUESTS": "40",
        "SYNC_REQUEST_SPACING_MS": "2100",
        "IMAGE_TRANSFORMS": "off",
        "EMAIL_DELIVERY": "off",
        "EMAIL_FROM": "\"Amelia & Aidan\" <wedding@daly.id.au>",
        "EMAIL_REPLY_TO": "wedding@daly.id.au",
        "SMS_DELIVERY": "off"
      },
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": {
          "enabled": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.1
        }
      },
      "ai": {
        "binding": "AI"
      },
      "vectorize": [
        {
          "binding": "VECTORS",
          "index_name": "daly-knowledge-staging"
        }
      ]
    }
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "daly-knowledge"
    }
  ]
}
