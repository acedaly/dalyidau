{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "dalyidau",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "tsconfig": "tsconfig.worker.json",
    "keep_vars": false,
    "minify": true,
    "define": {
        "process.env.NODE_ENV": "\"production\"",
    },
    "assets": {
        "directory": "dist/client",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "dalyidau-production",
            "database_id": "a003fec1-8404-4468-a23f-de5fb202bc57",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [
        {
            "binding": "MEDIA",
            "bucket_name": "dalyidau-media",
        },
    ],
    // Makes the smaller copies of published images (worker/lib/image-variants.ts). On the Images Free plan:
    // 5,000 unique transformations a month, never billed beyond that (new ones fail and the original is served).
    "images": { "binding": "IMAGES" },
    "triggers": {
        "crons": ["*/15 * * * *"],
    },
    "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://daly.id.au",
        "WEDDING_URL": "https://wedding.daly.id.au",
        "PLANNER_URL": "https://weddingplanner.daly.id.au",
        "CAPACITIES_API_BASE": "https://api.capacities.io",
        "CAPACITIES_STRUCTURE_NAME": "Blog Post",
        "SYNC_MAX_REQUESTS": "40",
        "SYNC_REQUEST_SPACING_MS": "2100",
        "IMAGE_TRANSFORMS": "variants",
        "EMAIL_DELIVERY": "fastmail",
        "EMAIL_FROM": "\"Amelia & Aidan\" <wedding@daly.id.au>",
        "EMAIL_REPLY_TO": "wedding@daly.id.au",
        "SMS_DELIVERY": "clicksend",
    },
    // Served only on the custom domains below: no *.workers.dev address (nothing uses one; the portal
    // refuses requests without a valid Access token on every hostname anyway).
    "workers_dev": false,
    "routes": [
        {
            "pattern": "daly.id.au",
            "custom_domain": true,
        },
        {
            "pattern": "www.daly.id.au",
            "custom_domain": true,
        },
        {
            "pattern": "wedding.daly.id.au",
            "custom_domain": true,
        },
        // Wedding Planner's own address (docs/PLANNER.md), added with the owner's approval (27 Oct 2026).
        // Until Cloudflare Access covers it, the Worker serves only a "sign-in isn't set up" page there.
        {
            "pattern": "weddingplanner.daly.id.au",
            "custom_domain": true,
        },
    ],
    "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": {
            "enabled": true,
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 0.1,
        },
    },
}
