# Variables for the e2e Worker (playwright.config.ts). Test values only, nothing secret.
# Passed with --env-file so a developer's own .dev.vars never changes test behaviour.
CAPACITIES_API_BASE=http://localhost:8790
CAPACITIES_API_TOKEN=cap-api-local-mock
ADMIN_TOKEN=e2e-admin-token-0123456789abcdef
SYNC_REQUEST_SPACING_MS=0
SITE_URL=http://localhost:8787
ENVIRONMENT=development
ACCESS_DEV_EMAIL=e2e-owner@example.com
ACCESS_DEV_ALT_EMAIL=e2e-partner@example.com
PORTAL_OWNER_EMAILS=e2e-owner@example.com
RSVP_LINK_SECRET=e2e-rsvp-link-secret-that-is-at-least-32-bytes
# Deterministic stand-in for Workers AI and Vectorize (worker/intelligence/bindings.ts). Development only.
AI_PROVIDER=mock
# Intelligence Centre: invented public-feed fixtures (scripts/mock-feeds.mjs), never a real provider. Development only.
CENTRE_FEED_BASE=http://localhost:8791
TFNSW_API_KEY=e2e-fixture-key-not-real
