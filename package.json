{
    "name": "dalyidau",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "npm run build:client && concurrently -k -n vite,worker \"vite build --watch\" \"wrangler dev --test-scheduled\"",
        "build:client": "vite build",
        "build": "npm run typecheck && vite build && wrangler deploy --dry-run --outdir dist/worker --env=\"\"",
        "typecheck": "tsc -b",
        "test": "vite build && vitest run",
        "test:e2e": "vite build && playwright test",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "mock:capacities": "node scripts/mock-capacities.mjs",
        "sync:local": "node scripts/trigger-sync.mjs http://localhost:8787",
        "deploy": "vite build && wrangler d1 migrations apply DB --remote --env=\"\" && wrangler deploy --env=\"\"",
        "format": "prettier --write .",
        "deploy:staging": "vite build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@react-aria/utils": "^3.34.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@untitledui/icons": "^0.0.23",
        "react": "^19.3.0",
        "react-aria": "^3.52.1",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.3.0",
        "react-stately": "^3.50.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.0",
        "@cloudflare/workers-types": "^5.20261011.1",
        "@playwright/test": "^1.56.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^9.2.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^4.1.0",
        "wrangler": "^4.149.0"
    },
    "engines": {
        "node": ">=22"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "esbuild@0.28.2": true,
        "workerd@1.20260815.1": true,
        "workerd@1.20261006.1": true
    }
}
