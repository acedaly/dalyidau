{
    "name": "dalyidau",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "npm run build:client && concurrently -k -n site,apps,worker \"vite build --watch\" \"vite build --config vite.apps.config.ts --watch\" \"wrangler dev --test-scheduled\"",
        "build:client": "rm -rf dist/client && vite build && vite build --config vite.apps.config.ts",
        "build": "npm run typecheck && npm run build:client && wrangler deploy --dry-run --outdir dist/worker --env=\"\"",
        "typecheck": "tsc -b",
        "test": "npm run build:client && vitest run",
        "test:e2e": "npm run build:client && playwright test",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "mock:capacities": "node scripts/mock-capacities.mjs",
        "sync:local": "node scripts/trigger-sync.mjs http://localhost:8787",
        "deploy": "npm run build:client && wrangler d1 migrations apply DB --remote --env=\"\" && wrangler deploy --env=\"\"",
        "format": "prettier --write .",
        "deploy:staging": "npm run build:client && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging",
        "seed:portal": "node scripts/seed-portal.mjs",
        "check:config": "node scripts/check-config.mjs",
        "check:bundle": "node scripts/check-bundle.mjs",
        "check:styles": "node scripts/check-style-tokens.mjs",
        "db:verify": "node scripts/db-verify.mjs",
        "db:backup": "node scripts/db-backup.mjs",
        "seed:staging": "node scripts/seed-staging.mjs"
    },
    "dependencies": {
        "@fontsource-variable/cormorant-garamond": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jost": "^5.3.0",
        "@internationalized/date": "^3.12.4",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@untitledui/file-icons": "^0.0.9",
        "@untitledui/icons": "^0.0.23",
        "motion": "^13.5.1",
        "react": "^19.3.0",
        "react-aria": "^3.53.1",
        "react-aria-components": "^1.22.1",
        "react-dom": "^19.3.0",
        "react-stately": "^3.51.0",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@cloudflare/vitest-plugin": "^1.4.0",
        "@cloudflare/workers-types": "^5.20261011.1",
        "@playwright/test": "^1.56.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^9.2.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^4.1.0",
        "wrangler": "^4.149.0"
    },
    "engines": {
        "node": ">=22"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "esbuild@0.28.2": true,
        "workerd@1.20260815.1": true,
        "workerd@1.20261006.1": true
    }
}
