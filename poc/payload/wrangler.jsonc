{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Phase 0 proof of concept only: local resources, no routes, no workers.dev, nothing remote.
    // Payload (through OpenNext) and the existing daly.id.au Worker in one script (platform/entry.ts).
    "name": "dalyidau-payload-poc",
    "main": "platform/entry.ts",
    "tsconfig": "tsconfig.platform.json",
    "compatibility_date": "2026-10-01", // production's date: the combined Worker must never move today's code backwards
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "workers_dev": false,
    "preview_urls": false,
    "routes": [],
    "minify": true,
    "keep_vars": false, // as production: vars in this file are the whole set
    "define": { "process.env.NODE_ENV": "\"production\"" },
    "assets": {
        // OpenNext's static files plus the existing site's build (merged by scripts/merge-assets.mjs).
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        // The Worker decides first for every request, so hostname rules apply to static files too.
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none",
    },
    "d1_databases": [
        // Payload's own content database.
        { "binding": "D1", "database_name": "payload-poc-content", "database_id": "00000000-0000-4000-8000-00000000c0de" },
        // The wedding (existing portal) database, with the existing migrations. Invented data only.
        { "binding": "DB", "database_name": "payload-poc-wedding", "database_id": "00000000-0000-4000-8000-0000000000db", "migrations_dir": "../../migrations" },
    ],
    "r2_buckets": [
        { "binding": "R2", "bucket_name": "payload-poc-media" },
        { "binding": "MEDIA", "bucket_name": "payload-poc-wedding-media" },
    ],
    "triggers": { "crons": ["*/15 * * * *"] },
    "vars": {
        "ENVIRONMENT": "development",
        "SITE_URL": "https://daly.id.au",
        "WEDDING_URL": "https://wedding.daly.id.au",
        "PLANNER_URL": "https://weddingplanner.daly.id.au",
        "CAPACITIES_API_BASE": "https://capacities.invalid",
        "CAPACITIES_STRUCTURE_NAME": "Blog Post",
        "SYNC_MAX_REQUESTS": "0",
        "SYNC_REQUEST_SPACING_MS": "0",
        "IMAGE_TRANSFORMS": "off",
        "EMAIL_DELIVERY": "log",
        "EMAIL_FROM": "\"Test Couple\" <wedding@example.test>",
        "SMS_DELIVERY": "log",
    },
    "env": {
        // Phase 1 staging (approved 11 Nov 2026): an isolated Worker on Cloudflare to measure real startup
        // and request performance. No routes, no custom domains, no workers.dev or preview URLs: nothing
        // public can reach it. Its own new databases and buckets, invented data only, no provider
        // credentials, deliveries logged, and every outbound request refused (platform/egress.ts).
        // scripts/check-staging.mjs proves none of this touches production; run it before every deploy.
        "staging": {
            "name": "dalyidau-payload-staging",
            "main": "platform/entry-staging.ts",
            "define": { "process.env.NODE_ENV": "\"production\"" },
            "workers_dev": false,
            "preview_urls": false,
            "routes": [],
            "d1_databases": [
                { "binding": "D1", "database_name": "dalyidau-payload-staging-content", "database_id": "da629290-cea1-4bae-83ee-e5d82b7e653e" },
                { "binding": "DB", "database_name": "dalyidau-payload-staging-wedding", "database_id": "cdbdc5aa-5edb-40b9-b69e-badd863993f8", "migrations_dir": "../../migrations" },
            ],
            "r2_buckets": [
                { "binding": "R2", "bucket_name": "dalyidau-payload-staging-media" },
                { "binding": "MEDIA", "bucket_name": "dalyidau-payload-staging-wedding-media" },
            ],
            "triggers": { "crons": ["*/15 * * * *"] },
            "vars": {
                "ENVIRONMENT": "staging",
                // Addresses that can't exist, so no link or email staging builds can lead anywhere real.
                "SITE_URL": "https://site.payload-staging.invalid",
                "WEDDING_URL": "https://wedding.payload-staging.invalid",
                "PLANNER_URL": "https://planner.payload-staging.invalid",
                "PORTAL_OWNER_EMAILS": "owner@example.test",
                "CAPACITIES_API_BASE": "https://capacities.invalid",
                "CAPACITIES_STRUCTURE_NAME": "Blog Post",
                "SYNC_MAX_REQUESTS": "0",
                "SYNC_REQUEST_SPACING_MS": "0",
                "IMAGE_TRANSFORMS": "off",
                "EMAIL_DELIVERY": "log",
                "EMAIL_FROM": "\"Test Couple\" <wedding@example.test>",
                "SMS_DELIVERY": "log",
            },
            "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true } },
        },
        // Production: the combined Worker deployed as `dalyidau` (docs/PAYLOAD-CUTOVER-PLAN.md). Everything
        // but the Payload additions must equal the repository root's wrangler.jsonc, which stays the source of
        // truth for the site's own database and migrations; scripts/production-config.mjs --check enforces it.
        // Deployed only by CI (.github/workflows/deploy.yml), never by hand.
        "production": {
            "name": "dalyidau",
            "main": "platform/entry.ts",
            "define": { "process.env.NODE_ENV": "\"production\"" },
            "workers_dev": false,
            "preview_urls": false,
            "routes": [
                { "pattern": "daly.id.au", "custom_domain": true },
                { "pattern": "www.daly.id.au", "custom_domain": true },
                { "pattern": "wedding.daly.id.au", "custom_domain": true },
                { "pattern": "weddingplanner.daly.id.au", "custom_domain": true },
            ],
            "d1_databases": [
                { "binding": "D1", "database_name": "dalyidau-payload", "database_id": "857fc770-666f-473b-8078-754c3cfb3ed3" },
                { "binding": "DB", "database_name": "dalyidau-production", "database_id": "a003fec1-8404-4468-a23f-de5fb202bc57", "migrations_dir": "../../migrations" },
            ],
            "r2_buckets": [
                { "binding": "R2", "bucket_name": "dalyidau-payload-media" },
                { "binding": "MEDIA", "bucket_name": "dalyidau-media" },
            ],
            "triggers": { "crons": ["*/15 * * * *"] },
            "vars": {
                "ENVIRONMENT": "production",
                "SITE_URL": "https://daly.id.au",
                "WEDDING_URL": "https://wedding.daly.id.au",
                "PLANNER_URL": "https://weddingplanner.daly.id.au",
                "CAPACITIES_API_BASE": "https://api.capacities.io",
                "CAPACITIES_STRUCTURE_NAME": "Blog Post",
                "SYNC_MAX_REQUESTS": "40",
                "SYNC_REQUEST_SPACING_MS": "2100",
                "IMAGE_TRANSFORMS": "off",
                "EMAIL_DELIVERY": "fastmail",
                "EMAIL_FROM": "\"Amelia & Aidan\" <wedding@daly.id.au>",
                "EMAIL_REPLY_TO": "wedding@daly.id.au",
                "SMS_DELIVERY": "clicksend",
            },
            "observability": {
                "enabled": true,
                "redact_query_string": true,
                "logs": { "enabled": true },
                "traces": { "enabled": true, "head_sampling_rate": 0.1 },
            },
        },
    },
}
